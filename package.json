{
  "name": "desafio-big-data-corp-batch",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/cli/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "npm run build && node dist/cli/index.js data/sample_clubes.jsonl output",
    "generate:sample": "node scripts/generate-sample.mjs data/sample/sample.jsonl 1000000",
    "sample": "npm run build && node dist/cli/index.js data/sample/sample.jsonl output/sample",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jskadomoto/desafio-big-data-corp-batch.git"
  },
